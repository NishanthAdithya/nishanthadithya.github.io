<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="card-body">
        <div class="d-flex align-items-center mb-3">
          {% if project.logo %}
            <img src="{{ project.logo | relative_url }}" alt="logo" style="height: 200px; width: auto; margin-right: 1.5rem; object-fit: contain;">
          {% endif %}
          <div>
            <h2 class="card-title mb-0">{{ project.title }}</h2>
            {% if project.role %}
              <p class="mb-0" style="font-size: 0.9rem; color: var(--global-theme-color);">{{ project.role }}</p>
            {% endif %}
            {% if project.advisor %}
              <p class="mb-0" style="font-size: 0.85rem; color: var(--global-text-color-light);">Advisor: {{ project.advisor }}</p>
            {% endif %}
          </div>
        </div>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>
